# Copy to .env and adjust. Never commit a real .env.

NODE_ENV=development

# API
PORT=12000
CORS_ORIGIN=http://localhost:12001

# Postgres (source of truth)
DATABASE_URL=postgres://vibe:vibe@localhost:5432/vibe

# Redis (cache / rate limits / ephemeral presence)
REDIS_URL=redis://localhost:6379

# Session token lifetime, seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# Payments: provider adapter. "stub" performs NO real provider calls.
# Per spec, provider/legal decisions marked VERIFY stay stubbed until approved.
PAYMENTS_PROVIDER=stub
PAYMENTS_WEBHOOK_SECRET=dev-only-stub-secret

# Public base URL of the API (used in links / webhook URLs)
PUBLIC_API_URL=http://localhost:12000
