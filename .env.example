# Copy to .env and adjust. Never commit a real .env.

NODE_ENV=development

# API
PORT=12000
CORS_ORIGIN=http://localhost:12001

# Postgres (source of truth)
DATABASE_URL=postgres://vibe:vibe@localhost:5432/vibe

# Redis (cache / rate limits / ephemeral presence)
REDIS_URL=redis://localhost:6379

# Session token lifetime, seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# Payments: provider adapter. "stub" performs NO real provider calls and is
# refused in production. Set "bachs" and supply the Bachs credentials below to
# run against the real provider (sandbox or live).
PAYMENTS_PROVIDER=stub
PAYMENTS_WEBHOOK_SECRET=dev-only-stub-secret

# Bachs (required when PAYMENTS_PROVIDER=bachs)
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_BASE_URL=https://sandbox-api.bachs.io
# PUBLIC_WEB_URL=http://localhost:12001

# Transactional email (required in production). Resend-compatible JSON API.
# Unset = the log mailer, which prints reset links to the process log. That is
# fine in development and is refused in production, because a user who cannot
# receive a reset email cannot recover their account.
# EMAIL_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Vibe <no-reply@yourdomain.com>
# EMAIL_BASE_URL=https://api.resend.com

# Public base URL of the API (used in links / webhook URLs)
PUBLIC_API_URL=http://localhost:12000
# Public base URL of the web client (used in password-reset links)
PUBLIC_WEB_URL=http://localhost:12001
# API origin the web client calls. Baked in at build time. Leave unset in
# development (Vite proxies /v1); set it in production when the API is on a
# different host from the web client.
# VITE_API_URL=https://vibeapi.example.com
