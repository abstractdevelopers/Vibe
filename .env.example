# Copy to .env and adjust. Never commit a real .env.

NODE_ENV=development

# API
PORT=12000
CORS_ORIGIN=http://localhost:12001

# Postgres (source of truth)
DATABASE_URL=postgres://vibe:vibe@localhost:5432/vibe

# Redis (cache / rate limits / ephemeral presence)
REDIS_URL=redis://localhost:6379

# Session token lifetime, seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# Payments: provider adapter. "stub" performs NO real provider calls and is
# refused in production. Set "bachs" and supply the Bachs credentials below to
# run against the real provider (sandbox or live).
PAYMENTS_PROVIDER=stub
PAYMENTS_WEBHOOK_SECRET=dev-only-stub-secret

# Bachs (required when PAYMENTS_PROVIDER=bachs)
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_BASE_URL=https://sandbox-api.bachs.io
# PUBLIC_WEB_URL=http://localhost:12001

# Public base URL of the API (used in links / webhook URLs)
PUBLIC_API_URL=http://localhost:12000
