{
  "name": "@vibe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vibe API — modular monolith (Fastify + PostgreSQL).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
